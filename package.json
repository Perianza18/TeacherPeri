{
  "name": "teacherperi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sitemap.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --watch server/src/server.js",
    "curriculum:preview:omm": "node server/src/scripts/preview-omm-curriculum.js",
    "curriculum:preview:omm-content": "node server/src/scripts/preview-omm-launch-content.js",
    "db:reset:dev": "node server/src/seed.js",
    "db:backfill:problem-categories": "node server/src/migrations/backfill-problem-categories.js",
    "db:apply:omm-curriculum": "node server/src/migrations/apply-omm-curriculum.js",
    "db:apply:omm-content-batch1": "node server/src/migrations/apply-omm-launch-content.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:integration": "vitest run --config vitest.config.js",
    "content:validate": "node --input-type=module -e \"import {validateMvpContent} from './server/src/data/validateMvpContent.js'; console.log(validateMvpContent())\"",
    "content:import": "node server/src/scripts/import-mvp-content.js",
    "content:check": "node server/src/scripts/check-local-content.js",
    "content:revise-theory": "node server/src/scripts/revise-theory-lessons.js",
    "content:import-ommeb-guerrero": "node server/src/scripts/import-ommeb-guerrero.js",
    "users:set-role": "node server/src/scripts/promote-user.js",
    "review": "node server/src/scripts/review-submissions.js",
    "db:migrate:roles-users": "node server/src/scripts/migrate-roles-users.js",
    "db:sync:exam-folders": "node server/src/scripts/sync-exam-folders.js",
    "content:import-exams": "node server/src/scripts/import-exam-problems.js",
    "db:local:start": "node server/src/scripts/start-local-mongo.js",
    "atlas:migrate:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test migrate",
    "atlas:migrate:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod migrate",
    "atlas:review:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test review",
    "atlas:review:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod review",
    "atlas:set-role:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test set-role",
    "atlas:set-role:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod set-role",
    "atlas:revise-theory:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test revise-theory",
    "atlas:revise-theory:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod revise-theory",
    "atlas:import:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test import",
    "atlas:import:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod import",
    "atlas:sync-exams:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test sync-exams",
    "atlas:sync-exams:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod sync-exams",
    "atlas:import-ommeb:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test import-ommeb",
    "atlas:import-ommeb:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod import-ommeb",
    "atlas:import-exams:test": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js test import-exams",
    "atlas:import-exams:prod": "node --env-file=\"$HOME/.config/teacherperi/atlas.env\" server/src/scripts/atlas.js prod import-exams",
    "test:browser": "playwright test",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.18.4",
    "mongoose": "^9.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
