# Local application database. This file contains no real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/teacherperi_dev
# Required: generate your own secret before starting the API (see docs/DEVELOPMENT.md).
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
# Production behind a reverse proxy only (Render: 3, measured; see
# docs/DEPLOYMENT.md). Number of trusted proxy hops used to read the client IP
# for rate limits. Leave unset locally.
# TRUST_PROXY_HOPS=3

# Integration tests read the shell environment, not this .env file.
# Their safe default is shown here for reference; this database is disposable.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/teacherperi_test

# Destructive DEVELOPMENT reset only. These are intentionally not enabled.
# Needs NODE_ENV=development and the exact database name confirmed
# (see docs/DEVELOPMENT.md).
# MONGO_DEV_RESET_URI=mongodb://127.0.0.1:27017/teacherperi_dev
# RESET_DATABASE_CONFIRM=teacherperi_dev

# Non-destructive local development migrations for reviewed, additive data changes.
# MONGO_MIGRATION_URI=mongodb://127.0.0.1:27017/teacherperi_dev
# MIGRATION_DATABASE_CONFIRM=teacherperi_dev
