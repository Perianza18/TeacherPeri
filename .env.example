# Local application database. This file contains no real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/teacherperi_dev
# Required: generate your own secret before starting the API (see README).
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Integration tests read the shell environment, not this .env file.
# Their safe default is shown here for reference; this database is disposable.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/teacherperi_test

# Destructive DEVELOPMENT reset only. These are intentionally not enabled.
# See README for the required NODE_ENV and exact database-name confirmation.
# MONGO_DEV_RESET_URI=mongodb://127.0.0.1:27017/teacherperi_dev
# RESET_DATABASE_CONFIRM=teacherperi_dev
